# Copy to .env next to the scripts, then: chmod 600 .env
# agent.py reads only ANTHROPIC_API_KEY and AGENT_* from this file;
# housekeeping.py reads only TELEGRAM_*. Real environment variables win.

# Tier 2 agent (use a dedicated key with a small prepaid balance, no auto-reload)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional agent settings (defaults shown)
#AGENT_MODEL=claude-haiku-5-5
#AGENT_EFFORT=medium
#AGENT_MAX_TOKENS=8000
#AGENT_MAX_ITERATIONS=8
#AGENT_MAX_GROUPS=10
#AGENT_RUN_BUDGET_USD=0.50
#AGENT_CHAT_BUDGET_USD=0.50

# Tier 1: your own source IPs or CIDRs (tests from home), comma separated. Sessions from them get
# label self_test and never reach the queue. Cron does not read this file: for the cron run, put the
# same entries in data/self_ips.txt (one per line, git-ignored). Documentation-range example:
#SELF_IPS=192.0.2.10,198.51.100.0/28

# Low-disk alert (housekeeping.py)
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
